{
  "app": {
    "name": "A2-2 AI News Pipeline",
    "timezone": "Asia/Seoul"
  },
  "database": {
    "path": "data/news.db"
  },
  "news": {
    "default_source": "inews24",
    "default_limit": 20,
    "request_timeout_seconds": 10,
    "crawl_delay_seconds": 1.5,
    "user_agent": "A2-2-Education-Project/1.0",
    "duplicate_policy": "skip",
    "categories": [
      "politics",
      "economy",
      "society",
      "it"
    ],
    "sources": {
      "inews24": {
        "enabled": true,
        "base_url": "https://www.inews24.com",
        "rss_urls": {
          "politics": "https://www.inews24.com/rss/news_politics.xml",
          "economy": "https://www.inews24.com/rss/news_economy.xml",
          "society": "https://www.inews24.com/rss/news_society.xml",
          "it": "https://www.inews24.com/rss/news_it.xml"
        }
      }
    }
  },
  "ai": {
    "provider": "mock",
    "api_key_env": "GEMINI_API_KEY",
    "model": "gemini-3.5-flash-lite",
    "timeout_seconds": 30,
    "max_input_chars": 12000,
    "max_output_tokens": 500,
    "max_retries": 2,
    "retry_base_seconds": 1.0
  },
  "report": {
    "default_top_n": 5,
    "chart_dpi": 150,
    "font_family": "auto",
    "output_directory": "reports"
  },
  "export": {
    "output_directory": "exports"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/app.log",
    "max_bytes": 1048576,
    "backup_count": 3
  }
}
